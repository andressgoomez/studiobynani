generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id
  displayName String
  role        String
  active      Boolean  @default(true)
  pinHash     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    Session[]
  attendances Attendance[]
  services    Service[] @relation("ServiceEmployees")
  productSales ProductSale[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Service {
  id              String       @id
  name            String
  category        String       @default("General")
  baseAmountCents Int
  durationMinutes Int
  active          Boolean      @default(true)
  sortOrder       Int          @default(0)
  employees       User[]       @relation("ServiceEmployees")
  attendances     Attendance[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Attendance {
  id                String   @id
  employeeId        String
  clientName        String
  serviceId         String
  serviceIdsJson    String   @default("[]")
  paymentMethod     String
  status            String   @default("performed")
  baseAmountCents   Int
  discountCents     Int
  finalAmountCents  Int
  commissionCents    Int
  amountToNaniCents Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  employee          User     @relation(fields: [employeeId], references: [id])
  service           Service  @relation(fields: [serviceId], references: [id])

  @@index([employeeId, createdAt])
  @@index([serviceId])
}

model DailyClosure {
  id            String    @id
  businessDate  String    @unique
  confirmedAt   DateTime
  confirmedById String
  reopenedAt    DateTime?
  reopenedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DailyRemittance {
  id          String    @id
  businessDate String
  employeeId  String
  amountCents Int
  sentAt      DateTime?
  receivedAt  DateTime?
  receivedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([businessDate, employeeId])
  @@index([employeeId, businessDate])
}

model Expense {
  id          String   @id
  expenseDate String
  category    String
  description String
  amountCents Int
  paidById    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expenseDate])
  @@index([category])
}

model MonthlyClosure {
  id            String    @id
  month         String    @unique
  confirmedAt   DateTime
  confirmedById String
  reopenedAt    DateTime?
  reopenedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AuditLog {
  id         String   @id
  actorId    String
  action     String
  entityType String
  entityId   String?
  detailsJson String  @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model Product {
  id                 String        @id
  name               String
  category           String        @default("General")
  supplierType       String
  supplierName       String
  currentCostCents   Int
  salePriceCents     Int
  lowStockThreshold  Int           @default(1)
  active             Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  purchases          ProductPurchase[]
  saleItems          ProductSaleItem[]

  @@index([supplierType])
  @@index([active])
}

model ProductPurchase {
  id             String   @id
  productId      String
  quantity       Int
  unitCostCents  Int
  supplierName   String
  purchasedAt    String
  createdById    String
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id])

  @@index([productId, purchasedAt])
}

model ProductSale {
  id                    String            @id
  sellerId              String
  clientName            String
  paymentMethod         String
  totalCents            Int
  profitCents           Int
  employeeCommissionCents Int
  amountToNaniCents     Int
  commonBoxCents        Int
  status                String            @default("completed")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  seller                User              @relation(fields: [sellerId], references: [id])
  items                 ProductSaleItem[]

  @@index([sellerId, createdAt])
}

model ProductSaleItem {
  id                 String      @id
  saleId             String
  productId          String
  quantity           Int
  unitCostCents      Int
  saleUnitPriceCents Int
  lineTotalCents     Int
  profitCents        Int
  sale               ProductSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product            Product     @relation(fields: [productId], references: [id])

  @@index([productId])
}

