generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id
  displayName String
  role        String
  active      Boolean  @default(true)
  pinHash     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sessions    Session[]
  attendances Attendance[]
  services    Service[] @relation("ServiceEmployees")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Service {
  id              String       @id
  name            String
  category        String       @default("General")
  baseAmountCents Int
  durationMinutes Int
  active          Boolean      @default(true)
  employees       User[]       @relation("ServiceEmployees")
  attendances     Attendance[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Attendance {
  id                String   @id
  employeeId        String
  clientName        String
  serviceId         String
  paymentMethod     String
  status            String   @default("performed")
  baseAmountCents   Int
  discountCents     Int
  finalAmountCents  Int
  commissionCents    Int
  amountToNaniCents Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  employee          User     @relation(fields: [employeeId], references: [id])
  service           Service  @relation(fields: [serviceId], references: [id])

  @@index([employeeId, createdAt])
  @@index([serviceId])
}

model DailyClosure {
  id            String    @id
  businessDate  String    @unique
  confirmedAt   DateTime
  confirmedById String
  reopenedAt    DateTime?
  reopenedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model DailyRemittance {
  id          String    @id
  businessDate String
  employeeId  String
  amountCents Int
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([businessDate, employeeId])
  @@index([employeeId, businessDate])
}

model Expense {
  id          String   @id
  expenseDate String
  category    String
  description String
  amountCents Int
  paidById    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expenseDate])
  @@index([category])
}

model MonthlyClosure {
  id            String    @id
  month         String    @unique
  confirmedAt   DateTime
  confirmedById String
  reopenedAt    DateTime?
  reopenedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

