{
  "name": "studiobynani",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run db:deploy && concurrently \"npm run dev --workspace @studiobynani/api\" \"npm run dev --workspace @studiobynani/web\"",
    "build": "npm run build --workspace @studiobynani/api && npm run build --workspace @studiobynani/web",
    "test": "vitest run --no-file-parallelism",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:reset-demo": "tsx scripts/reset-demo-attendances.ts",
    "db:start-real": "tsx scripts/start-real-db.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  }
}
